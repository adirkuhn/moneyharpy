{
  "name": "moneyharpy-web",
  "version": "0.1.0",
  "scripts": {
    "dev": "vite",
    "predev": "node scripts/copy-redoc.mjs",
    "prebuild": "node scripts/copy-redoc.mjs",
    "build": "tsc --noEmit && vite build && node -e \"require('fs').writeFileSync('dist/.gitkeep','')\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "gen:api": "openapi-typescript ../api/openapi.yaml -o src/api/schema.d.ts"
  },
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@tanstack/react-query": "^5.107.1",
    "i18next": "^27.1.0",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.1",
    "react-router-dom": "^7.18.5",
    "redoc": "^3.1.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.0",
    "msw": "^3.0.4",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "private": true
}
