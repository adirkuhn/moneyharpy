# Everything else is configured from the app and stored in the database.
POSTGRES_PASSWORD=change-me
# Encrypts secrets at rest. Generate with: openssl rand -base64 48
SECRET_KEY=
BASE_URL=http://localhost:8080
# Credentials of the bundled S3-compatible file storage. Enter the same values
# under Instance settings > File storage, with endpoint http://storage:8333.
S3_ACCESS_KEY=moneyharpy
S3_SECRET_KEY=
